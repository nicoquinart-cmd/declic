rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validCourse() {
      let d = request.resource.data;
      return d.keys().hasOnly(['version','title','source','revisions','engine','mapTitle','createdAt','updatedAt'])
        && d.keys().hasAll(['version','title','source','revisions','engine','mapTitle','createdAt','updatedAt'])
        && d.version == 1
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.source is string && d.source.size() > 0 && d.source.size() <= 250000
        && (d.revisions == null || (
          d.revisions is map
          && d.revisions.keys().hasAll(['summary','cards','topics','audio','mode'])
          && d.revisions.summary is string && d.revisions.audio is string && d.revisions.mode is string
          && d.revisions.cards is list && d.revisions.topics is list
        ))
        && d.engine in ['browser','simple','ollama']
        && d.mapTitle is string && d.mapTitle.size() <= 80
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/courses/{courseId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validCourse() && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validCourse() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
